@*
========================================
STUDENT C PAYMENT MODULE - SIMULATED CHECKOUT PAGE
========================================
*@

@model SportHub.ViewModels.PaymentCheckoutViewModel

@{
    ViewData["Title"] = "Payment";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <section class="payment-checkout-card">
            <span class="text-success fw-bold">SECURE PAYMENT SIMULATION</span>
            <h1 class="h2 mt-2">Choose how to pay</h1>
            <p class="text-muted">
                Invoice @Model.InvoiceNumber · RM @Model.Amount.ToString("N2")
            </p>

            <form asp-action="Checkout" method="post">
                <input asp-for="ReservationId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Method" class="form-label"></label>
                    <select asp-for="Method" asp-items="Model.MethodOptions" class="form-select"></select>
                    <span asp-validation-for="Method" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TransactionReference" class="form-label"></label>
                    <input asp-for="TransactionReference" class="form-control"
                           autocomplete="off" placeholder="Example: TNG-482910" />
                    <span asp-validation-for="TransactionReference" class="text-danger"></span>
                    <div class="form-text">Use a made-up reference for this assignment simulation.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="PayerAccountLastFour" class="form-label"></label>
                    <input asp-for="PayerAccountLastFour" class="form-control"
                           inputmode="numeric" maxlength="4" autocomplete="off"
                           placeholder="Example: 1234" />
                    <span asp-validation-for="PayerAccountLastFour" class="text-danger"></span>
                </div>

                <div class="alert alert-warning">
                    Do not enter a real password, PIN, OTP, complete bank account number
                    or card number. SportHub does not request or store them.
                </div>

                <button type="submit" class="btn btn-success">Submit payment for verification</button>
                <a asp-action="Invoice" asp-route-reservationId="@Model.ReservationId"
                   class="btn btn-outline-secondary">Back to invoice</a>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
