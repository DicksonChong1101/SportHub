@*
========================================
FACILITY IMAGE MODULE - MANAGE DISPLAY COVER
========================================
*@

@model SportHub.ViewModels.FacilityCoverImageViewModel

@{
    ViewData["Title"] = "Manage display cover";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <span class="text-primary fw-semibold text-uppercase small">
                @Model.CategoryName
            </span>
            <h1 class="h2 mb-1">Manage display cover</h1>
            <p class="text-muted mb-0">
                Choose the main image shown for @Model.FacilityName on the Home page.
            </p>
        </div>

        <div class="facility-cover-preview mb-4">
            <img src="@Model.CurrentImagePath"
                 alt="@Model.FacilityName current display cover" />
            <span class="badge @(Model.HasCustomCover ? "bg-success" : "bg-secondary")">
                @(Model.HasCustomCover ? "Custom cover" : "Category default")
            </span>
        </div>

        <form asp-action="ManageCover"
              method="post"
              enctype="multipart/form-data"
              class="border rounded-4 p-4 bg-white shadow-sm">
            <input asp-for="FacilityId" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="CoverImage"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="CoverImage"
                       type="file"
                       class="form-control"
                       accept="image/jpeg,image/png,image/webp" />

                <span asp-validation-for="CoverImage"
                      class="text-danger">
                </span>

                <div class="form-text">
                    JPG, PNG or WebP. Maximum file size: 5 MB.
                    A landscape image works best.
                </div>
            </div>

            @if (Model.HasCustomCover)
            {
                <div class="form-check mb-4">
                    <input asp-for="RemoveCoverImage"
                           class="form-check-input" />
                    <label asp-for="RemoveCoverImage"
                           class="form-check-label">
                    </label>
                    <span asp-validation-for="RemoveCoverImage"
                          class="text-danger d-block">
                    </span>
                </div>
            }

            <button type="submit" class="btn btn-primary">
                Save display cover
            </button>

            <a asp-controller="Facilities"
               asp-action="Details"
               asp-route-id="@Model.FacilityId"
               class="btn btn-outline-secondary">
                Cancel
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
