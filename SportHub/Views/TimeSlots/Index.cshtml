@*
========================================
TIME SLOT MODULE - TIME SLOT LIST PAGE
========================================
*@

@model IReadOnlyList<TimeSlot>

@{
    ViewData["Title"] = "Time slots";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h2 mb-1">Time slots</h1>
        <p class="text-muted mb-0">Manage the standard booking periods offered each day.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create time slot</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">No time slots have been created.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Order</th>
                <th>Time</th>
                <th>Status</th>
                <th>Reservations</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var timeSlot in Model)
            {
                <tr>
                    <td>@timeSlot.DisplayOrder</td>
                    <td>@timeSlot.DisplayText</td>
                    <td>
                        <span class="badge @(timeSlot.IsActive ? "bg-success" : "bg-secondary")">
                            @(timeSlot.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>@timeSlot.Reservations.Count</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@timeSlot.TimeSlotId"
                           class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Edit" asp-route-id="@timeSlot.TimeSlotId"
                           class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@timeSlot.TimeSlotId"
                           class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
        </table>
    </div>
}
