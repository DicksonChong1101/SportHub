@*
========================================
TIME SLOT MODULE - EDIT TIME SLOT PAGE
========================================
*@

@model SportHub.ViewModels.TimeSlotFormViewModel

@{
    ViewData["Title"] = "Edit time slot";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h1 class="h2">Edit time slot</h1>
        <form asp-action="Edit"
              asp-route-id="@ViewContext.RouteData.Values["id"]"
              method="post">
            @* Reuses the same button-ready form fields and validation as Create. *@
            <partial name="_Form" model="Model" />
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
