@*
======================================================
STUDENT B ADDITIONAL FEATURE - PUBLIC QR PASS CHECK
Shows booking validity without exposing private profile data.
======================================================
*@

@model Reservation

@{
    ViewData["Title"] = "Reservation pass";
    var isValid = Model.Status is ReservationStatuses.Pending
        or ReservationStatuses.Approved
        or ReservationStatuses.Completed;
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-6">
        <section class="card border-0 shadow reservation-validation-card">
            <div class="card-body p-4 p-lg-5 text-center">
                <span class="badge @(isValid ? "bg-success" : "bg-danger") mb-3">
                    @(isValid ? "Valid SportHub pass" : "Inactive SportHub pass")
                </span>
                <h1 class="h2 mb-1">@Model.Facility.Name</h1>
                <p class="text-muted mb-4">@Model.ReservationNumber</p>

                <dl class="row text-start mb-0">
                    <dt class="col-5">Date</dt>
                    <dd class="col-7">@Model.ReservationDate.ToString("dd MMM yyyy")</dd>
                    <dt class="col-5">Time</dt>
                    <dd class="col-7">@Model.TimeSlot.DisplayText</dd>
                    <dt class="col-5">Status</dt>
                    <dd class="col-7">@Model.Status</dd>
                </dl>
            </div>
        </section>
    </div>
</div>
