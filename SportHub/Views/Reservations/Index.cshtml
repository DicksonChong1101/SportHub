@*
========================================
MEMBER RESERVATION MODULE - RESERVATION LIST PAGE
========================================
*@

@model SportHub.ViewModels.ReservationIndexViewModel

@{
    ViewData["Title"] = "My reservations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h2 mb-1">My reservations</h1>
        <p class="text-muted mb-0">Review your booking history and current reservation status.</p>
    </div>
    <a asp-controller="Booking" asp-action="Index" class="btn btn-primary">Book a facility</a>
</div>

@* Student B additional feature: searchable filters remain selected after submit. *@
<form method="get" class="card card-body border-0 shadow-sm mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-lg-3">
            <label asp-for="Search" class="form-label">Search</label>
            <input asp-for="Search" class="form-control"
                   placeholder="Reservation or facility" />
        </div>
        <div class="col-sm-6 col-lg-2">
            <label asp-for="Status" class="form-label">Status</label>
            <select asp-for="Status" class="form-select">
                <option value="">All statuses</option>
                <option value="@ReservationStatuses.Pending">Pending</option>
                <option value="@ReservationStatuses.Approved">Approved</option>
                <option value="@ReservationStatuses.Rejected">Rejected</option>
                <option value="@ReservationStatuses.Cancelled">Cancelled</option>
                <option value="@ReservationStatuses.Completed">Completed</option>
            </select>
        </div>
        <div class="col-sm-6 col-lg-2">
            <label asp-for="FromDate" class="form-label">From date</label>
            <input asp-for="FromDate" type="date" class="form-control" />
        </div>
        <div class="col-sm-6 col-lg-2">
            <label asp-for="ToDate" class="form-label">To date</label>
            <input asp-for="ToDate" type="date" class="form-control" />
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="form-check mb-2">
                <input asp-for="UpcomingOnly" class="form-check-input" />
                <label asp-for="UpcomingOnly" class="form-check-label">Upcoming only</label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Apply filters</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </div>
    </div>
</form>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (Model.Reservations.Count == 0)
{
    <div class="alert alert-info">
        No reservations match the selected filters.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Reservation</th>
                    <th>Facility</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th>Amount</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reservation in Model.Reservations)
                {
                    var statusBadgeClass = reservation.Status switch
                    {
                        ReservationStatuses.Pending => "bg-warning text-dark",
                        ReservationStatuses.Approved => "bg-success",
                        ReservationStatuses.Rejected => "bg-danger",
                        ReservationStatuses.Completed => "bg-primary",
                        _ => "bg-secondary"
                    };

                    <tr>
                        <td>@reservation.ReservationNumber</td>
                        <td>@reservation.Facility.Name</td>
                        <td>@reservation.ReservationDate.ToString("dd MMM yyyy")</td>
                        <td>@reservation.TimeSlot.DisplayText</td>
                        <td><span class="badge @statusBadgeClass">@reservation.Status</span></td>
                        <td>@(reservation.Payment?.Status ?? PaymentStatuses.Unpaid)</td>
                        <td>RM @reservation.TotalAmount.ToString("N2")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@reservation.ReservationId"
                               class="btn btn-sm btn-outline-primary">Details</a>
                            @{
                                var reservationStart = reservation.ReservationDate
                                    .ToDateTime(reservation.TimeSlot.StartTime);
                                var canCancel = reservationStart > DateTime.Now &&
                                    reservation.Status is ReservationStatuses.Pending
                                        or ReservationStatuses.Approved &&
                                    reservation.Payment?.Status != PaymentStatuses.Paid;
                            }
                            @if (canCancel)
                            {
                                <a asp-action="Cancel" asp-route-id="@reservation.ReservationId"
                                   class="btn btn-sm btn-outline-danger">Cancel</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
