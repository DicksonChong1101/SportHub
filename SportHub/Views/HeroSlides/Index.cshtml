@*
========================================
HOME HERO MODULE - ADMIN BANNER LIST
========================================
*@

@using SportHub.Services
@model IReadOnlyList<HeroSlide>

@{
    ViewData["Title"] = "Home banners";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Home banners</h1>
        <p class="text-muted mb-0">
            Manage the images and messages shown in the Home page slideshow.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add banner
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No custom Home banners exist. The default SportHub banner is being used.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var slide in Model)
        {
            <div class="col-md-6 col-xl-4">
                <article class="card h-100 shadow-sm overflow-hidden">
                    <img src="@HeroSlideImageService.GetDisplayPath(slide.StoredFileName)"
                         alt="@(slide.AltText ?? slide.Title)"
                         class="hero-admin-thumbnail" />

                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between gap-2 mb-2">
                            <span class="badge @(slide.IsActive ? "bg-success" : "bg-secondary")">
                                @(slide.IsActive ? "Active" : "Inactive")
                            </span>
                            <span class="text-muted small">
                                Order @slide.DisplayOrder
                            </span>
                        </div>

                        <h2 class="h5">@slide.Title</h2>
                        <p class="text-muted flex-grow-1">
                            @(slide.Subtitle ?? "No subtitle")
                        </p>

                        <div class="d-flex gap-2">
                            <a asp-action="Edit"
                               asp-route-id="@slide.HeroSlideId"
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>
                            <a asp-action="Delete"
                               asp-route-id="@slide.HeroSlideId"
                               class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
