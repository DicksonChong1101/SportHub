@*
========================================
ACCOUNT MODULE - LOGIN PAGE
========================================
*@

@* This strongly typed view binds the login form to LoginViewModel. *@
@model SportHub.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Sign in to SportHub</h1>
                <p class="text-muted">Access your reservations and account.</p>

                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="alert alert-success" role="alert">
                        @successMessage
                    </div>
                }

                @if (ViewData["UnconfirmedEmail"] is string unconfirmedEmail)
                {
                    <div class="alert alert-warning" role="alert">
                        <div class="mb-2">This account still needs email verification.</div>
                        <a asp-action="ResendActivation"
                           asp-route-email="@unconfirmedEmail"
                           class="btn btn-sm btn-warning">
                            Resend activation email
                        </a>
                    </div>
                }

                @* Preserves the local page that the user originally attempted to access. *@
                <form asp-action="Login" asp-route-returnUrl="@returnUrl" method="post">
                    @* Displays model-level errors returned by the login process. *@
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        @* Displays validation errors associated specifically with Email. *@
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        @* Controls whether the authentication cookie persists across browser sessions. *@
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Login</button>
                </form>

                <p class="mt-3 mb-0 text-center">
                    <a asp-controller="PasswordRecovery"
                       asp-action="ForgotPassword">
                        Forgot password?
                    </a>
                </p>

                <p class="mt-2 mb-0 text-center">
                    <a asp-action="ResendActivation">Need a new activation link?</a>
                </p>

                <p class="mt-3 mb-0 text-center">
                    Do not have an account?
                    <a asp-action="Register">Register</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
