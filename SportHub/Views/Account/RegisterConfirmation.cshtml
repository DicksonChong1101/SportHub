@*
========================================
STUDENT A ADDITIONAL - REGISTRATION EMAIL SENT
========================================
*@

@{
    ViewData["Title"] = "Check your email";
    var email = ViewData["Email"] as string;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5 text-center">
                <div class="display-5 mb-3" aria-hidden="true">&#9993;</div>
                <h1 class="h2 mb-3">Check your email</h1>
                <p class="text-muted">
                    We sent a SportHub activation link
                    @if (!string.IsNullOrWhiteSpace(email))
                    {
                        <text>to <strong class="text-body">@email</strong></text>
                    }
                    . The link is valid for 24 hours.
                </p>
                <p class="small text-muted">
                    Check your spam folder if it does not appear. You must activate
                    the account before signing in.
                </p>

                <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
                    <a asp-action="Login" class="btn btn-primary">Go to login</a>
                    <a asp-action="ResendActivation"
                       asp-route-email="@email"
                       class="btn btn-outline-secondary">
                        Resend activation email
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
