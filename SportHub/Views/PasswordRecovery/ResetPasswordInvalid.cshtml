@*
========================================
ACCOUNT MODULE - INVALID RESET LINK PAGE
========================================
*@
@{
    ViewData["Title"] = "Reset link unavailable";
}

<div class="row justify-content-center recovery-shell">
    <div class="col-md-7 col-lg-5">
        <div class="card border-0 recovery-card text-center">
          <div class="card-body p-4 p-lg-5">
            <img src="~/images/sporthub-logo.png"
                 alt="SportHub"
                 class="recovery-brand-logo mb-3" />
            <div class="recovery-status-icon recovery-status-warning mb-3"
                 aria-hidden="true">!</div>
            <h1 class="h3">This reset link cannot be used</h1>
            <p class="text-muted">
                It may be invalid, expired, or already used.
                Request a new password-reset email to continue.
            </p>
            <a asp-action="ForgotPassword"
               class="btn btn-primary">
                Request a new link
            </a>
          </div>
        </div>
    </div>
</div>
