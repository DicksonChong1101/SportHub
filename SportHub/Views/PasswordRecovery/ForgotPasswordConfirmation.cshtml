@*
========================================
ACCOUNT MODULE - RESET EMAIL CONFIRMATION
========================================
*@
@{
    ViewData["Title"] = "Check your email";
}

<div class="row justify-content-center recovery-shell">
    <div class="col-md-7 col-lg-5">
        <div class="card border-0 recovery-card text-center">
            <div class="card-body p-4 p-lg-5">
                <img src="~/images/sporthub-logo.png"
                     alt="SportHub"
                     class="recovery-brand-logo mb-3" />
                <div class="recovery-status-icon recovery-status-success mb-3"
                     aria-hidden="true">✓</div>
                <h1 class="h3">Check your email</h1>
                <p class="text-muted">
                    If an active SportHub account matches that address,
                    a single-use password-reset link has been sent.
                    The link expires in 30 minutes.
                </p>
                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-primary">
                    Return to sign in
                </a>
            </div>
        </div>
    </div>
</div>
