@*
========================================
ACCOUNT MODULE - FORGOT PASSWORD PAGE
========================================
*@
@model SportHub.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot password";
}

<div class="row justify-content-center recovery-shell">
    <div class="col-md-7 col-lg-5">
        <div class="card border-0 recovery-card">
            <div class="card-body p-4 p-lg-5">
                <div class="text-center mb-3">
                    <img src="~/images/sporthub-logo.png"
                         alt="SportHub"
                         class="recovery-brand-logo" />
                </div>
                <span class="text-primary fw-semibold text-uppercase small">
                    Account recovery
                </span>
                <h1 class="h3 mt-2">Forgot your password?</h1>
                <p class="text-muted">
                    Enter your registered email address and SportHub will send a secure reset link.
                </p>

                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email"
                               class="form-label fw-semibold"></label>
                        <input asp-for="Email"
                               class="form-control"
                               autocomplete="email" />
                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Send reset link
                    </button>
                </form>

                <p class="text-center mt-3 mb-0">
                    <a asp-controller="Account"
                       asp-action="Login">
                        Back to sign in
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
