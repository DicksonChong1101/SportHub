@*
========================================
FACILITY CATEGORY MODULE - DELETE CATEGORY PAGE
========================================
*@

@model FacilityCategory

@{
    ViewData["Title"] = "Delete facility category";
}

<h1 class="h2 text-danger">Delete facility category</h1>

@if (Model.Facilities.Count > 0)
{
    <div class="alert alert-warning">
        This category is used by @Model.Facilities.Count facility record(s) and cannot be deleted.
        Edit the category and deactivate it instead.
    </div>
}
else
{
    <div class="alert alert-danger">
        Are you sure you want to permanently delete <strong>@Model.Name</strong>?
    </div>
}

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@(Model.Description ?? "—")</dd>
</dl>

@if (Model.Facilities.Count == 0)
{
    <form asp-action="Delete" asp-route-id="@Model.FacilityCategoryId" method="post" class="d-inline">
        <button type="submit" class="btn btn-danger">Delete permanently</button>
    </form>
}

<a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
