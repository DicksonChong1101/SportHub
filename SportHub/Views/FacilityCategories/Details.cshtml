@*
========================================
FACILITY CATEGORY MODULE - CATEGORY DETAILS PAGE
========================================
*@

@model FacilityCategory

@{
    ViewData["Title"] = "Facility category details";
}

<h1 class="h2">Facility category details</h1>

<dl class="row mt-4">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@(Model.Description ?? "—")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>

    <dt class="col-sm-3">Facilities using category</dt>
    <dd class="col-sm-9">@Model.Facilities.Count</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.FacilityCategoryId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
