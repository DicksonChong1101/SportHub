@*
========================================
FACILITY CATEGORY MODULE - CATEGORY LIST PAGE
========================================
*@

@model IReadOnlyList<FacilityCategory>

@{
    ViewData["Title"] = "Facility categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h2 mb-1">Facility categories</h1>
        <p class="text-muted mb-0">Manage the types of sports facilities offered.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create category</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">No facility categories have been created.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td>@category.Name</td>
                        <td>@(category.Description ?? "—")</td>
                        <td>
                            <span class="badge @(category.IsActive ? "bg-success" : "bg-secondary")">
                                @(category.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@category.FacilityCategoryId"
                               class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@category.FacilityCategoryId"
                               class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@category.FacilityCategoryId"
                               class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
